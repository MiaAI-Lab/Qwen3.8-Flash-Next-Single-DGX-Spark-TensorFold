# Port to expose on host
PORT=8888

# Hugging Face Model ID
MODEL_ID=Vontra/Qwen3.8-Flash-Next-MLX-4bit-MTP

# Served model name advertised in /v1/models
SERVED_NAME=Qwen3.8-Flash-Next

# Concurrency & Context settings
# 1 stream with 262,144 context window (single request profile)
PARALLEL=1
CONTEXT=262144
KV_DTYPE=int8

# PLE (n-gram table) on SSD: 1 = stream rows from SSD/NVMe (saves ~30GB unified RAM)
PLE_ON_SSD=1

# Vision capabilities: 1 = enable image/video inputs (requires PARALLEL >= 2 on CUDA; set 0 for single stream)
VISION=0
VISION_URLS=0
VISION_MAX_IMAGES=50

# Sampling parameters
TEMPERATURE=1.0
TOP_P=0.95
TOP_K=20
THINKING=1
MAX_TOKENS=32768

# MTP speculative drafting parameters
MTP_DRAFTS=6
MTP_CONFIDENCE=0.60
TENSORFOLD_MTP_COPY=1

# Memory and prefill performance knobs
TENSORFOLD_PREFILL_ROWS=2048
TENSORFOLD_MEMORY_RESERVE_GIB=2

# HF cache and Kernel cache on host
HF_CACHE=/home/admin/.cache/huggingface
KERNEL_CACHE=/home/admin/.cache/tensorfold-qwen38

# External Docker network for other services
EXTERNAL_NETWORK=llm-network

# Offline serving once downloaded
HF_HUB_OFFLINE=1
