+fn mediaHistoryLen(srv: *Server, cx: *Cx, normalized: Value, options: model_text.RenderOptions, text: []const u8, ids: []const u32) usize {
+    var o = options;
+    o.add_generation_prompt = false;
+    var problem: []const u8 = "";
+    const history = srv.text.render(cx.a, normalized, o, &problem) catch return 0;
+    if (history.len == 0 or history.len >= text.len or !std.mem.startsWith(u8, text, history)) return 0;
+    const suffix = srv.text.encode(cx.a, text[history.len..], false) catch return 0;
+    if (suffix.len == 0 or suffix.len >= ids.len or !std.mem.endsWith(u32, ids, suffix)) return 0;
+    return ids.len - suffix.len;
+}
