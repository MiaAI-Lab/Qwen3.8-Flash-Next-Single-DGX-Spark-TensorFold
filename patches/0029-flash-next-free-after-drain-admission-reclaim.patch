+test "admission frees kept states, never the prompt's own resume, before it refuses a prompt" {
+    const gpa = std.testing.allocator;
+    var t: Toy = .{ .gpa = gpa };
+    t.budget.limit = 25_000; // 100 bytes a row: a 100-row stream 10,000, kept states at 20 and 50 rows 7,000
+    var b = Lanes(Toy).init(gpa, &t, true, 4096, max_rows);
+    defer b.deinit();
+    var store: KeepAll = .{ .hooks = b.cacheHooks(1 << 30) };
+    defer store.saved.deinit(gpa);
+    var ev: EvictOldest = .{ .store = &store };
+    var long: [60]u32 = undefined;
+    for (&long, 0..) |*x, i| x.* = @intCast((i * 13 + 5) % 47);
+    var s1 = try lanes.Stream.init(gpa, .{ .id = "a", .prompt = &long, .max_new = 24 });
+    defer s1.deinit(gpa);
+    s1.reuse = .{ .marks = &.{ 20, 50 }, .hook = .{ .ptr = &store, .at = KeepAll.hook } };
+    try b.backend().prefill(&s1);
+    b.backend().release(&s1);
+    try std.testing.expectEqual(@as(usize, 2), store.saved.items.len);
+    try std.testing.expectEqual(@as(u64, 7_000), b.kept_bytes);
+    var s2 = try lanes.Stream.init(gpa, .{ .id = "b", .prompt = &.{ 1, 2, 3 }, .max_new = 81 });
+    defer s2.deinit(gpa);
+    try b.backend().prefill(&s2); // 10,000 + 7,000 kept
+    var s3 = try lanes.Stream.init(gpa, .{ .id = "c", .prompt = &long, .max_new = 24 });
+    defer s3.deinit(gpa);
+    s3.reuse = .{ .saved = store.saved.items[1], .at = 50 };
+    try std.testing.expectError(error.NoRoom, b.backend().prefill(&s3)); // no store to ask: refused as before
+    b.cacheHooks(0).set_reclaim.?(&b, .{ .ptr = &ev, .evict = EvictOldest.evict });
+    b.admit_reclaim = false;
+    try std.testing.expectError(error.NoRoom, b.backend().prefill(&s3)); // switched off: refused as before
+    b.admit_reclaim = true;
+    try b.backend().prefill(&s3); // 27,000 > 25,000: the state at 20 goes, the one s3 resumes stays
+    try std.testing.expectEqual(@as(u32, 50), s3.cached);
+    try std.testing.expectEqual(Toy.next(&long, &.{}, null, 60), try b.backend().read(try b.backend().first(&s3, 60)));
+    try std.testing.expectEqual(@as(usize, 1), store.saved.items.len);
+    try std.testing.expectEqual(@as(u64, 5_000), b.kept_bytes);
+    b.backend().release(&s3);
+    var s4 = try lanes.Stream.init(gpa, .{ .id = "d", .prompt = &long, .max_new = 124 });
+    defer s4.deinit(gpa);
+    s4.reuse = .{ .saved = store.saved.items[0], .at = 50 };
+    try std.testing.expectError(error.NoRoom, b.backend().prefill(&s4)); // only its own resume is left: refused
+    try std.testing.expectEqual(@as(usize, 1), store.saved.items.len);
+    b.backend().release(&s2);
+    for (store.saved.items) |sv| b.cacheHooks(0).drop(&b, sv);
+    try std.testing.expectEqual(@as(u64, 0), b.kept_bytes);
+    try std.testing.expectEqual(@as(usize, 0), t.snaps);
+    try std.testing.expectEqual(@as(usize, 0), t.seqs);
+}
