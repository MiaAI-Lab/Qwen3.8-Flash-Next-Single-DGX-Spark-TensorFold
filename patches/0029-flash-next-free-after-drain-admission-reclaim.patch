+/// The store's admission eviction a test plays: the oldest kept state other than `skip` goes (Store.reclaim).
+const EvictOldest = struct {
+    store: *KeepAll,
+
+    fn evict(ptr: *anyopaque, skip: ?*anyopaque, _: []const u32) bool {
+        const x: *EvictOldest = @ptrCast(@alignCast(ptr));
+        for (x.store.saved.items, 0..) |sv, i| if (sv != skip) {
+            x.store.hooks.drop(x.store.hooks.ptr, sv);
+            _ = x.store.saved.orderedRemove(i);
+            return true;
+        };
+        return false;
+    }
