+test "a pass refused for room mid-prompt frees its lane only once the work queued on it is done" {
+    const gpa = std.testing.allocator;
+    var t: Toy = .{ .gpa = gpa };
+    var b = Lanes(Toy).init(gpa, &t, true, 4096, max_rows);
+    defer b.deinit();
+    var store: KeepAll = .{ .hooks = b.cacheHooks(1 << 30) };
+    defer store.saved.deinit(gpa);
+    var long: [80]u32 = undefined;
+    for (&long, 0..) |*x, i| x.* = @intCast((i * 13 + 5) % 47);
+    // turn 1 keeps at 20 and, late, at 50: its release hands its sequence over as the late state's keeper
+    var s1 = try lanes.Stream.init(gpa, .{ .id = "a", .prompt = long[0..60], .max_new = 8 });
+    defer s1.deinit(gpa);
+    s1.reuse = .{ .marks = &.{ 20, 50 }, .hook = .{ .ptr = &store, .at = KeepAll.hook } };
+    try b.backend().prefill(&s1);
+    b.backend().release(&s1);
+    try std.testing.expectEqual(@as(usize, 2), store.saved.items.len);
+    try std.testing.expectEqual(@as(usize, 0), t.freed_busy);
+    // turn 2 resumes at 50 (its copy from the keeper queued) and its snapshot at 70 is refused for room after the
+    // chunks before it were queued: the request fails, the lane goes, and nothing else may
+    var s2 = try lanes.Stream.init(gpa, .{ .id = "b", .prompt = &long, .max_new = 8 });
+    defer s2.deinit(gpa);
+    s2.reuse = .{ .saved = store.saved.items[1], .at = 50, .marks = &.{70}, .hook = .{ .ptr = &store, .at = KeepAll.hook } };
+    t.refuse_snapshot = true;
+    try std.testing.expectError(error.NoRoom, b.backend().prefill(&s2));
+    t.refuse_snapshot = false;
+    // without the drain the lane was freed under its queued copy and chunks: CUDA_ERROR_ILLEGAL_ADDRESS on the GPU
+    try std.testing.expectEqual(@as(usize, 0), t.freed_busy);
+    try std.testing.expectEqual(@as(usize, 2), store.saved.items.len);
+    for (store.saved.items) |sv| b.cacheHooks(0).drop(&b, sv);
+    try std.testing.expectEqual(@as(usize, 0), t.freed_busy);
+    try std.testing.expectEqual(@as(u64, 0), b.kept_bytes);
+    try std.testing.expectEqual(@as(usize, 0), t.snaps);
+    try std.testing.expectEqual(@as(usize, 0), t.seqs);
+}
