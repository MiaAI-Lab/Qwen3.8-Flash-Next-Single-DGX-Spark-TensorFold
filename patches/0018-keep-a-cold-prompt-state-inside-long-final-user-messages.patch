+    const different = try s.lookupUser(a, prompt, @intCast(prompt.len), 13000, 16, 13000, &.{}, &.{}, &.{.{ 100, 200 }});
+    defer if (different.entry) |e| s.release(e);
+    try std.testing.expect(different.entry == null or different.entry.?.at < at);
+}
