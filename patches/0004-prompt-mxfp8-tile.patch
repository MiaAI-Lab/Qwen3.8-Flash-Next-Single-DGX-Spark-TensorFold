+        commit();
+    }
+    for (int g = 0; g < KG; ++g) {
+        wait<STAGES - 2>();
+        __syncthreads();
+        if (g + STAGES - 1 < KG) load((g + STAGES - 1) % STAGES, g + STAGES - 1);
