+                    if (col < N) dst[0] = v0;
+                    if (col + 1 < N) dst[1] = v1;
+                } else {
+                    __nv_bfloat16* dst = reinterpret_cast<__nv_bfloat16*>(out) + static_cast<size_t>(row) * N + col;
