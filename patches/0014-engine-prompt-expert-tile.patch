+/// `experts-tile-check [--rows N,N,...] [--plans file,file,...]`: no checkpoint; fn_experts_tile.cu against nvfp4_expert_kernel and
+/// the prompt kernel (synthetic and skewed routing, special values, TP=1 and TP=2 widths, recorded plans).
+fn expertsTileCheck(gpa: Allocator, ctx: *const cuda.Context, o: Options) !u8 {
+    var k = try flashnext.kernels.Kernels.load(ctx);
+    defer k.deinit();
+    var p = try flashnext.moe_prompt.Prompt4.init(ctx);
+    defer p.deinit();
+    var tx = try flashnext.moe_tile.Tile4.init(ctx);
+    defer tx.deinit();
+    var stream = try cuda.Stream.init(ctx.d, true);
+    defer stream.deinit();
+    const ops: flashnext.kernels.Ops = .{ .k = &k, .s = stream };
+    var rows: std.ArrayList(usize) = .empty;
+    defer rows.deinit(gpa);
+    var files: std.ArrayList([]const u8) = .empty;
+    defer files.deinit(gpa);
+    if (o.rows.len > 0) {
+        var it = std.mem.tokenizeScalar(u8, o.rows, ',');
+        while (it.next()) |r| try rows.append(gpa, try std.fmt.parseInt(usize, r, 10));
+    }
+    if (o.plans.len > 0) {
+        var it = std.mem.tokenizeScalar(u8, o.plans, ',');
+        while (it.next()) |r| try files.append(gpa, r);
+    }
+    var ok = true;
+    if (files.items.len > 0) {
+        ok = (try flashnext.moe_tile.check(gpa, ctx, ops, &p, &tx, 640, &.{}, files.items, false, false)) and ok;
+    } else {
+        if (rows.items.len == 0) try rows.appendSlice(gpa, &.{ 129, 200, 974, 2048, 2049, 4096 });
+        const all_cfgs = [_][3]usize{ .{ 64, 0, 0 }, .{ 64, 1, 1 }, .{ 64, 2, 2 }, .{ 64, 3, 0 }, .{ 48, 4, 0 }, .{ 128, 0, 1 }, .{ 16, 0, 2 } };
+        // TF_FLASHNEXT_PROMPT_EXPERT_TILE_CFG set: only that configuration (Tile4.init read it)
+        const one = [_][3]usize{.{ tx.tile, tx.i_gu, tx.i_dn }};
+        const cfgs: []const [3]usize = if (std.c.getenv("TF_FLASHNEXT_PROMPT_EXPERT_TILE_CFG") != null) &one else &all_cfgs;
+        for (cfgs) |c| {
+            tx.tile = c[0];
+            tx.i_gu = c[1];
+            tx.i_dn = c[2];
+            for ([_]usize{ 640, 320 }) |ni| {
+                ok = (try flashnext.moe_tile.check(gpa, ctx, ops, &p, &tx, ni, rows.items, &.{}, false, false)) and ok;
+                ok = (try flashnext.moe_tile.check(gpa, ctx, ops, &p, &tx, ni, rows.items, &.{}, true, false)) and ok;
+            }
+            ok = (try flashnext.moe_tile.check(gpa, ctx, ops, &p, &tx, 640, rows.items, &.{}, true, true)) and ok;
+        }
+    }
+    std.debug.print("{s} experts-tile-check: the shared-memory expert tile {s} the old kernels\n", .{ if (ok) "PASS" else "FAIL", if (ok) "byte-equal to" else "DIFFERS from" });
+    return if (ok) 0 else 1;
+}
