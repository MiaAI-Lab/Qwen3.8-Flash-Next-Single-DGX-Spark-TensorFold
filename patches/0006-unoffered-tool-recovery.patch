diff --git a/zig/src/server/tool_parse_test.zig b/zig/src/server/tool_parse_test.zig
--- a/zig/src/server/tool_parse_test.zig
+++ b/zig/src/server/tool_parse_test.zig
@@ -598,3 +598,41 @@
 test {
     _ = @import("tool_parse_visibility_test.zig");
 }
+
+
+test "opt-in unoffered Qwen XML recovery" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const tools = (try json.parse(a, "[{\"type\":\"function\",\"function\":{\"name\":\"lookup\"}}]")).ok.array;
+    const raw = "<tool_call>\n<function=view_generated_image>\n<parameter=image_url>\n/tmp/probe.png\n</parameter>\n</function>\n</tool_call>";
+    for ([_]?usize{null, 1}) |limit| {
+        const off = try parse(a, raw, tools, limit);
+        try std.testing.expect(off.calls == null);
+        try std.testing.expectEqualStrings(raw, off.content);
+    }
+    tool_parse.Testing.forward_unoffered = true;
+    defer tool_parse.Testing.forward_unoffered = false;
+    for ([_]?usize{null, 1}) |limit| {
+        const on = try parse(a, raw, tools, limit);
+        try std.testing.expectEqual(@as(usize, 1), on.calls.?.len);
+        try std.testing.expectEqualStrings("", on.content);
+        try std.testing.expectEqual(@as(usize, 0), on.rejected_envelopes);
+        const f = on.calls.?[0].get("function").?;
+        try std.testing.expectEqualStrings("view_generated_image", f.get("name").?.string);
+        try std.testing.expectEqualStrings("{\"image_url\":\"/tmp/probe.png\"}", f.get("arguments").?.string);
+        for ([_][]const u8{
+            "{\"name\":\"view_generated_image\",\"arguments\":{}}",
+            "<tool_call><function=bad.name></function></tool_call>",
+            "<tool_call><function=missing><parameter=x>oops</function></tool_call>",
+            "<tool_call><function=missing></function>",
+            "```xml\n" ++ raw ++ "\n```",
+        }) |text| {
+            const r = try parse(a, text, tools, limit);
+            try std.testing.expect(r.calls == null);
+            try std.testing.expectEqualStrings(text, r.content);
+        }
+        try std.testing.expect((try parse(a, raw, &.{}, limit)).calls == null);
+    }
+    try std.testing.expectEqualStrings("", try closeCall(a, raw[0..raw.len - "</tool_call>".len], tools));
+}
