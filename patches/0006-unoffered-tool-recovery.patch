+
+
+test "opt-in unoffered Qwen XML streams once at its closer" {
+    tool_parse.Testing.forward_unoffered = true;
+    defer tool_parse.Testing.forward_unoffered = false;
+    const raw = "<tool_call>\n<function=view_generated_image>\n<parameter=image_url>\n/tmp/probe.png\n</parameter>\n</function>\n</tool_call>";
+    const offered = "<tool_call><function=lookup></function></tool_call>";
+    for ([_][]const u8{"", offered}) |prefix| {
+        for (0..prefix.len + raw.len + 1) |boundary| {
+            var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+            defer arena.deinit();
+            const a = arena.allocator();
+            const tools = (try json.parse(a, "[{\"type\":\"function\",\"function\":{\"name\":\"lookup\"}}]")).ok.array;
+            const text = try std.mem.concat(a, u8, &.{prefix, raw});
+            var stream_test = try Streamer.init(a, tools);
+            var out: std.ArrayList(Value) = .empty;
+            try stream_test.feed(text[0..boundary], &out);
+            if (boundary < text.len) for (out.items) |delta| {
+                for (delta.get("tool_calls").?.array) |call| {
+                    if (call.get("function").?.get("name")) |name| try std.testing.expect(!std.mem.eql(u8, name.string, "view_generated_image"));
+                }
+            };
+            try stream_test.feed(text, &out);
+            try stream_test.feed(text, &out);
+            var count: usize = 0;
+            var args: std.ArrayList(u8) = .empty;
+            const wanted: i64 = if (prefix.len == 0) 0 else 1;
+            for (out.items) |delta| for (delta.get("tool_calls").?.array) |call| {
+                if (call.get("index").?.int64().? != wanted) continue;
+                const f = call.get("function").?;
+                if (f.get("name")) |name| {
+                    try std.testing.expectEqualStrings("view_generated_image", name.string);
+                    count += 1;
+                }
+                if (f.get("arguments")) |part| try args.appendSlice(a, part.string);
+            };
+            try std.testing.expectEqual(@as(usize, 1), count);
+            try std.testing.expectEqualStrings("{\"image_url\":\"/tmp/probe.png\"}", args.items);
+        }
+    }
+}
