+        .part = try r.out(most * n_down * 4),
+        .act = try r.out(most * low * 2),
+        .xs = try r.out(most * (low / 32) * 4),
+        .inj = try r.out(most * streams * 2),
+        .up = try r.out(most * wide * 2),
+        .mixed = try r.out(most * dims * 2),
