+    b.add(eps);
+    try cuda.launch.launch(k.tiles.hcn_up[ui], .{ .grid = .{ .x = @intCast(cdiv(n, bm_u) * (dims / 32)) }, .block = .{ .x = 256 }, .shared = tk.hcnUpSmem(tk.hcn_up_mt[ui]) }, stream, &b);
