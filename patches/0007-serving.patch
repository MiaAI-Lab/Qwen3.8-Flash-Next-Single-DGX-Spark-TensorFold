+    try tmp.dir.writeFile(io, .{ .sub_path = "config.json", .data = @embedFile("fixtures_cuda_config.json") });
+    const dir = try std.fmt.allocPrint(gpa, ".zig-cache/tmp/{s}", .{tmp.sub_path});
+    defer gpa.free(dir);
