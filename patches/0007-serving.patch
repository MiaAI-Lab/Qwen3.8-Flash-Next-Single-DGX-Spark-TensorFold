+    defer g.deinit(gpa);
+    try std.testing.expect(!g.armed);
+    try std.testing.expect((try g.cut(a, &.{7})) == null);
+    try g.observe(gpa, 4);
+    try std.testing.expect(g.armed);
+    const blank = (try g.cut(a, &.{1}));
+    try std.testing.expect(blank == null);
+}
