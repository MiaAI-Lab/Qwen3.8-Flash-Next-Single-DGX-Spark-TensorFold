+    try std.testing.expectEqual(Toy.next(&.{ 1, 2, 3 }, &.{first}, null, 4), sampled[0]);
+    try be_.keep(&.{.{ .stream = &s, .pending = first, .held = 15, .tokens = &.{}, .parents = null, .positions = &positions }}, &.{&.{0}});
