+// Target-guided long-context MTP draft selection: reuses up to (top*ratio - 64) guided distant keys strictly before
+// (end - 64) from target layer 43's verify selection, then appends the exact 64 most recent tokens [end-64 .. end).
+// Skips fn_qsa_scores and fn_qsa_select over 65K-262K pooled blocks while preserving strict causal order.
+extern "C" __global__ void __launch_bounds__(256) fn_qsa_guide_apply(const int* __restrict__ guide,
+                                                                     const int* __restrict__ pos0,
+                                                                     int* __restrict__ ids, int* __restrict__ nkr,
+                                                                     int* __restrict__ spr, int idw, int top,
+                                                                     int ratio) {
+    __shared__ int warp_sums[8];
+    const int r = blockIdx.x;
+    const int end = *pos0 + r + 1;
+    const int budget = top * ratio;
+    int* out = ids + static_cast<long long>(r) * idw;
+    if (end <= budget) {
+        if (threadIdx.x == 0) {
+            nkr[r] = end;
+            spr[r] = 0;
+        }
+        return;
+    }
+    constexpr int RECENT = 64;
+    const int recent_start = end - RECENT;
+    const int keep_max = budget - RECENT;
+    const int t = threadIdx.x, warp = t >> 5, lane = t & 31;
+    const unsigned below = (1u << lane) - 1u;
+    // Each thread checks 8 slots of `guide[0 .. budget)` (256 * 8 = 2048); compact valid IDs < recent_start.
+    int vals[8];
+    int mine = 0;
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+        const int idx = (warp * 8 + i) * 32 + lane;
+        const int id = (idx < budget) ? guide[idx] : -1;
+        const bool ok = (id >= 0 && id < recent_start);
+        vals[i] = ok ? id : -1;
+        mine += ok ? 1 : 0;
+    }
+    int warp_total = mine;
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) warp_total += __shfl_xor_sync(0xffffffffu, warp_total, o);
+    if (lane == 0) warp_sums[warp] = warp_total;
+    __syncthreads();
+    int warp_base = 0;
+    for (int w = 0; w < warp; ++w) warp_base += warp_sums[w];
+    int total_valid = warp_base;
+    for (int w = warp; w < 8; ++w) total_valid += warp_sums[w];
+    int place = warp_base;
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+        const bool ok = vals[i] >= 0;
+        const unsigned mask = __ballot_sync(0xffffffffu, ok);
+        if (ok) {
+            const int dst = place + __popc(mask & below);
+            if (dst < keep_max) out[dst] = vals[i];
+        }
+        place += __popc(mask);
+    }
+    const int kept = min(total_valid, keep_max);
+    if (t < RECENT) out[kept + t] = recent_start + t;
+    if (t == 0) {
+        nkr[r] = kept + RECENT;
+        spr[r] = 1;
+    }
+}
