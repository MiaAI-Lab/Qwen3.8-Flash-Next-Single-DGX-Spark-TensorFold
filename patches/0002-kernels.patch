+                        }
+#pragma unroll
+                        for (int i = 0; i < T::MT; ++i)
+#pragma unroll
+                            for (int e = 0; e < 4; ++e) acc[i][j][e] = __fmaf_rn(d[i][j][e], (e & 1) ? s1 : s0, acc[i][j][e]);
+                    }
+                }
+            }
+        }
+    }
