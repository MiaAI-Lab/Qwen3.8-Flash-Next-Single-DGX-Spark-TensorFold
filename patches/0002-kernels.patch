+            if (it > 0 && it % slice_groups == 0) {        // a slice ends: add it to the sum, start the next from zero
+#pragma unroll
+                for (int i = 0; i < T::MT; ++i)
+#pragma unroll
+                    for (int j = 0; j < T::NT; ++j)
+#pragma unroll
+                        for (int e = 0; e < 4; ++e) {
+                            tot[i][j][e] = it == slice_groups ? acc[i][j][e] : tot[i][j][e] + acc[i][j][e];
+                            acc[i][j][e] = 0.0f;
+                        }
+            }
+        }
