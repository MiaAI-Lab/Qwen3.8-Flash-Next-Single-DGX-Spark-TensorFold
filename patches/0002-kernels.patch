+    static constexpr int THREADS = WM * WN * 32;
+    static constexpr int MT = BM / WM / 16;
+    static constexpr int NT = BN / WN / 8;
+    static constexpr int ROW = GS * 2;
+    static constexpr int CHUNKS = ROW / 16;
