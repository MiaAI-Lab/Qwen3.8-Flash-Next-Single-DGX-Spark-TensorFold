@@ -187,6 +187,8 @@ pub const Kernels = struct {
     shift: cuda.Function,
     /// Each sparse row's top blocks (attention._select / _select_tiles), native.
     select: cuda.Function,
+    /// The abliteration of a writer's rows (cuda_ablate.zig).
