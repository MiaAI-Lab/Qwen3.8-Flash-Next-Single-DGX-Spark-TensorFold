+    const int tail = ratio * complete + tid;
+    if (tail < end) out[top * ratio + tid] = tail;
+  }
+  if (tid == 0) {
+    NKR[r] = top * ratio + end - ratio * complete;
+    SPR[r] = 1;
+  }
