+        var a: cuda.Args = .{};
+        a.add(picks);
+        a.add(int(pairs));
+        a.add(int(experts));
+        a.add(p.rank);
+        a.add(p.hist);
+        try o.go(o.k.plan_rank, .{ nblk, 1, 1 }, 1024, 0, &a);
+        var b: cuda.Args = .{};
+        for ([_]usize{ nblk, experts, tile }) |v| b.add(int(v));
+        for ([_]u64{ p.hist, p.items, p.counts }) |v| b.add(v);
