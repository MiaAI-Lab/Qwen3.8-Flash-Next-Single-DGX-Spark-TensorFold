+        const block = 256;
+        var br = p("BR", bf16, h);
+        var y = p("Y", bf16, h);
+        var wts = p("WTS", bf16, h);
+        var mode: usize = 0;
+        var top: usize = 1;
+        var slots: usize = 1;
+        var world: usize = 1;
