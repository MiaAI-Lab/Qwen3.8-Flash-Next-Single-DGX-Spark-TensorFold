+        var a: cuda.Args = .{};
+        for ([_]u64{ p, conv_state, conv_w, state_in, a_log, dt_bias, norm_w }) |v| a.add(v);
+        a.add(eps);
+        a.add(int(rows));
+        for ([_]u64{ out, xs, state_out, k_save, v_save, g_save, b_save }) |v| a.add(v);
