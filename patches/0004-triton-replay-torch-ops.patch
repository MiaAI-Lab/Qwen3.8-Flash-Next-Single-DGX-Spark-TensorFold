+            .none => {},
+            .bf16 => |b| {
+                mode = 1;
+                br = p("BR", bf16, b);
+            },
+            .moe => |m| {
+                mode = 2;
+                y = p("Y", if (m.y_f32) f32p else bf16, m.y);
