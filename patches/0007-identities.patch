diff --git a/zig/src/core/lanes/identities.zig b/zig/src/core/lanes/identities.zig
new file mode 100644
index 0000000..82e75f8
--- /dev/null
+++ b/zig/src/core/lanes/identities.zig
@@ -0,0 +1,47 @@
+//! The identities a server offers beside the stock model: a model id each, the directions file its requests get.
+const std = @import("std");
+
+pub const max = 32;
+
+/// A model id and the safetensors file its rows are abliterated by (families/flashnext/cuda_ablate.zig).
+pub const Identity = struct { id: []const u8, path: []const u8 };
+
+pub const Error = error{ IdentitiesTooMany, IdentitiesMalformed, IdentitiesDuplicate };
+
+/// TENSORFOLD_IDENTITIES' `id=path` entries (commas or newlines apart) in order, numbered 1..n (0: the stock model).
+pub fn list(spec: ?[]const u8, legacy_path: ?[]const u8, legacy_id: ?[]const u8, out: *[max]Identity) Error![]Identity {
+    var n: usize = 0;
+    // TENSORFOLD_IDENTITIES unset: the TENSORFOLD_ABLATE and TENSORFOLD_ABLATE_MODEL pair is the whole list
+    if (spec) |s| {
+        var it = std.mem.tokenizeAny(u8, s, ",\n");
+        while (it.next()) |raw| {
+            const entry = std.mem.trim(u8, raw, " \t\r");
+            if (entry.len == 0) continue;
+            const eq = std.mem.indexOfScalar(u8, entry, '=') orelse return error.IdentitiesMalformed;
+            const id = std.mem.trim(u8, entry[0..eq], " \t");
+            const path = std.mem.trim(u8, entry[eq + 1 ..], " \t");
+            if (id.len == 0 or path.len == 0) return error.IdentitiesMalformed;
+            for (out[0..n]) |seen| if (std.mem.eql(u8, seen.id, id)) return error.IdentitiesDuplicate;
+            if (n == max) return error.IdentitiesTooMany;
+            out[n] = .{ .id = id, .path = path };
+            n += 1;
+        }
+    } else if (legacy_path) |p| if (legacy_id) |id| {
+        const path = std.mem.trim(u8, p, " \t\r\n");
+        const name = std.mem.trim(u8, id, " \t\r\n");
+        if (path.len > 0 and name.len > 0) {
+            out[0] = .{ .id = name, .path = path };
+            n = 1;
+        }
+    };
+    return out[0..n];
+}
+
+/// The process's list (TENSORFOLD_IDENTITIES, else the legacy TENSORFOLD_ABLATE and TENSORFOLD_ABLATE_MODEL pair).
+pub fn fromEnv(out: *[max]Identity) Error![]Identity {
+    return list(env("TENSORFOLD_IDENTITIES"), env("TENSORFOLD_ABLATE"), env("TENSORFOLD_ABLATE_MODEL"), out);
+}
+
+fn env(name: [:0]const u8) ?[]const u8 {
+    return if (std.c.getenv(name)) |v| std.mem.span(v) else null;
+}
