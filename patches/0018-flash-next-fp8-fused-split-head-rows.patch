diff --git a/zig/src/families/flashnext/cuda_int4_check.zig b/zig/src/families/flashnext/cuda_int4_check.zig
index 80910f8..ec4ac15 100644
--- a/zig/src/families/flashnext/cuda_int4_check.zig
+++ b/zig/src/families/flashnext/cuda_int4_check.zig
@@ -614,3 +614,107 @@ pub fn check(gpa: Allocator, ctx: *const cuda.Context, ops: kern.Ops) !bool {
     try bench(gpa, &k, ops, ctx.d, 2);
