+/// Relaxed greedy verification over `vals`/`cols` (at least `topk_limit` highest candidates, any order):
+/// accepts `draft_opt` if it ranks within the top `topk_limit` and within `margin` of the top logit; else exact argmax.
+pub fn pickGreedyRelaxed(vals: []const u16, cols: []const i32, draft_opt: ?u32, topk_limit: usize, margin: f64) !u32 {
+    if (vals.len == 0 or vals.len > topk_max or vals.len != cols.len) return error.ProposalScoreShape;
+    var order: [topk_max]lanes.sampling.Candidate = undefined;
+    for (vals, cols, 0..) |b, c, i| {
+        const fv: f64 = mtp.promote(b);
+        if (!std.math.isFinite(fv) or c < 0 or c >= vocab) return error.ProposalNonfinite;
+        order[i] = .{ .value = fv, .id = @intCast(c) };
+    }
+    const n = vals.len;
+    std.mem.sort(lanes.sampling.Candidate, order[0..n], {}, struct {
+        fn less(_: void, a: lanes.sampling.Candidate, b: lanes.sampling.Candidate) bool {
+            return if (a.value != b.value) a.value > b.value else a.id < b.id;
+        }
+    }.less);
+    if (draft_opt) |draft| {
+        const limit = @min(n, topk_limit);
+        const top_v = order[0].value;
+        for (order[0..limit]) |cand| {
+            if (cand.id == draft and top_v - cand.value <= margin) return draft;
+        }
+    }
+    return @intCast(order[0].id);
+}
+
+/// Relaxed sampled verification over a row's top_k candidates: accepts `draft_opt` when u < exp(soft) * p(draft)
+/// under the filtered target distribution (temperature, top_p, min_p), otherwise falls back to exact `drawTopk`.
+pub fn drawTopkRelaxed(gpa: std.mem.Allocator, vals: []const u16, cols: []const i32, position: u64, s: Sampling, draft_opt: ?u32, soft: f64) !u32 {
+    if (draft_opt == null or soft <= 0.0) return drawTopk(gpa, vals, cols, null, position, s);
+    if (vals.len == 0 or vals.len > topk_max or vals.len != cols.len) return error.ProposalScoreShape;
+    var order: [topk_max]lanes.sampling.Candidate = undefined;
+    const n = vals.len;
+    for (vals, cols, 0..) |b, c, i| {
+        const fv: f64 = mtp.promote(b);
+        if (!std.math.isFinite(fv) or c < 0 or c >= vocab) return error.ProposalNonfinite;
+        order[i] = .{ .value = fv, .id = @intCast(c) };
+    }
+    std.mem.sort(lanes.sampling.Candidate, order[0..n], {}, struct {
+        fn less(_: void, a: lanes.sampling.Candidate, b: lanes.sampling.Candidate) bool {
+            return if (a.value != b.value) a.value > b.value else a.id < b.id;
+        }
+    }.less);
+    const t = @max(s.temperature, 1e-6);
+    var scaled: [topk_max]f64 = undefined;
+    for (0..n) |i| scaled[i] = order[i].value / t;
+    var keep = n;
+    if (s.top_p > 0.0 and s.top_p < 1.0) {
+        var probs: [topk_max]f64 = undefined;
+        var total: f64 = 0.0;
+        for (0..n) |i| {
+            probs[i] = @exp(scaled[i] - scaled[0]);
+            total += probs[i];
+        }
+        var cum: f64 = 0.0;
+        var below: usize = 0;
+        for (0..n) |i| {
+            cum += probs[i] / total;
+            if (cum < s.top_p) below += 1;
+        }
+        keep = @min(keep, below + 1);
+    }
+    if (s.min_p > 0.0) {
+        const floor = scaled[0] + s.minLog();
+        var cnt: usize = 0;
+        for (scaled[0..keep]) |x| {
+            if (x >= floor) cnt += 1;
+        }
+        keep = @max(@as(usize, 1), cnt);
+    }
+    const draft = draft_opt.?;
+    var kept_total: f64 = 0.0;
+    var draft_mass: f64 = 0.0;
+    for (0..keep) |i| {
+        const w = @exp(scaled[i] - scaled[0]);
+        kept_total += w;
+        if (order[i].id == draft) draft_mass = w;
+    }
+    if (draft_mass > 0.0 and kept_total > 0.0) {
+        const p_draft = draft_mass / kept_total;
+        const u = lanes.sampling.uniform(s.seed ^ 0x517CC1B727220A95, position, draft);
+        if (u < @exp(soft) * p_draft) return draft;
+    }
+    return drawTopk(gpa, vals, cols, null, position, s);
+}
