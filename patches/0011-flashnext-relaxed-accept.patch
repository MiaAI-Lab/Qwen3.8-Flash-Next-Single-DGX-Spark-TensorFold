+/// Opt-in lossy relaxed speculative verification (0 = exact).
+pub const RelaxedAccept = struct {
+    topk: usize = 0,
+    margin: f64 = 0.0,
+    soft: f64 = 0.0,
+
+    pub fn resolve() RelaxedAccept {
+        const env = @import("sys").environment;
+        const topk = @min(@as(usize, 64), env.read(usize, "TF_FLASHNEXT_ACCEPT_TOPK", 0) catch 0);
+        const margin = env.read(f64, "TF_FLASHNEXT_ACCEPT_MARGIN", 0.0) catch 0.0;
+        const soft = env.read(f64, "TF_FLASHNEXT_ACCEPT_SOFT", 0.0) catch 0.0;
+        return .{ .topk = topk, .margin = margin, .soft = soft };
+    }
+
+    pub fn greedyOn(r: RelaxedAccept) bool {
+        return r.topk > 1;
+    }
+
+    pub fn sampledOn(r: RelaxedAccept) bool {
+        return r.soft > 0.0;
+    }
+};
