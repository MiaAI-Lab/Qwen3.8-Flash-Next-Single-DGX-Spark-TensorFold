+/// Opt-in lossy verify-time MoE expert-union budgeting (0 = off / exact).
+pub const VerifyMoeBudget = struct {
+    budget: usize = 0,
+    budget_max: usize = 64,
+    keep: usize = 4,
+    parseval: bool = true,
+
+    pub fn resolve() VerifyMoeBudget {
+        const env = @import("sys").environment;
+        return .{
+            .budget = env.read(usize, "TF_FLASHNEXT_VERIFY_MOE_BUDGET", 0) catch 0,
+            .budget_max = env.read(usize, "TF_FLASHNEXT_VERIFY_MOE_BUDGET_MAX", 64) catch 64,
+            .keep = @max(@as(usize, 1), @min(@as(usize, 10), env.read(usize, "TF_FLASHNEXT_VERIFY_MOE_KEEP", 4) catch 4)),
+            .parseval = env.read(bool, "TF_FLASHNEXT_VERIFY_MOE_PARSEVAL", true) catch true,
+        };
+    }
+
+    pub fn effectiveFor(b: VerifyMoeBudget, rows: usize) usize {
+        if (b.budget == 0) return 0;
+        const cap = @max(b.budget, b.budget_max);
+        if (rows <= 9) return b.budget;
+        return @min(cap, b.budget + (rows - 9) * 2);
+    }
+};
+
