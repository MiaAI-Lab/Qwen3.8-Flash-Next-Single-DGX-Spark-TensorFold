index 8190cf709..2e189a6de 100644
--- a/zig/kernels/cuda/route_rows.cu
+++ b/zig/kernels/cuda/route_rows.cu
@@ -115,3 +115,177 @@ extern "C" __global__ void __launch_bounds__(NT) tf_route_topk(const float* __re
