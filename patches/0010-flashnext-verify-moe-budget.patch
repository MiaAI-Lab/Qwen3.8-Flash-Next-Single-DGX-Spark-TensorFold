+
+// Opt-in verify-time expert-union budgeting (1 block of 256 threads, M <= 64, NE <= 512, C = 32 candidates/row):
+// Guarantees each row's top `KEEP` experts, fills the union up to `BUDGET` by summed routing probability mass,
+// then picks each row's top-K candidates in the union with optional Parseval (full top-K mass) renormalization.
+// Unfilled slots (rare) receive pick = NE (skip) and weight = 0.0f. Deterministic, zero extra global scratch.
+extern "C" __global__ void __launch_bounds__(256) tf_route_topk_budget(
+    const float* __restrict__ L, int NL, int NE, int TOPK,
+    int* __restrict__ PICK, float* __restrict__ WTS, int SLOTS,
+    int shared, int M, int KEEP, int BUDGET, int PARSEVAL) {
+    constexpr int MAX_M = 64;
+    constexpr int MAX_E = 512;
+    constexpr int CANDS = 32;
+    __shared__ uint32_t in_set[MAX_E / 32];
+    __shared__ float score[MAX_E];
+    __shared__ int cand_id[MAX_M][CANDS];
+    __shared__ float cand_p[MAX_M][CANDS];
+    __shared__ float row_sum_topk[MAX_M];
+    __shared__ float red_v[8];
+    __shared__ int red_i[8];
+
+    const int t = threadIdx.x;
+    const int warp = t >> 5;
+    const int lane = t & 31;
+
+    if (t < MAX_E / 32) in_set[t] = 0u;
+    score[t] = 0.0f;
+    score[t + 256] = 0.0f;
+    __syncthreads();
+
+    // Phase 1: each warp ranks top-32 candidates for its rows, marks mandatory top-KEEP bits, accumulates score[e].
+    for (int r = warp; r < M; r += 8) {
+        const float* row = L + static_cast<long long>(r) * NL;
+        float v[16];
+        float vmax = -INFINITY;
+#pragma unroll
+        for (int j = 0; j < 16; ++j) {
+            const int e = lane + j * 32;
+            const float x = (e < NE) ? row[e] : -INFINITY;
+            v[j] = x;
+            if (x > vmax) vmax = x;
+        }
+#pragma unroll
+        for (int off = 16; off > 0; off >>= 1) vmax = fmaxf(vmax, __shfl_xor_sync(0xffffffffu, vmax, off));
+
+        float p[16];
+        float z = 0.0f;
+#pragma unroll
+        for (int j = 0; j < 16; ++j) {
+            const int e = lane + j * 32;
+            const float ex = (e < NE) ? tf_exp(__fsub_rn(v[j], vmax)) : 0.0f;
+            p[j] = ex;
+            z = __fadd_rn(z, ex);
+        }
+#pragma unroll
+        for (int off = 16; off > 0; off >>= 1) z = __fadd_rn(z, __shfl_xor_sync(0xffffffffu, z, off));
+        const float inv_z = (z > 0.0f) ? __fdiv_rn(1.0f, z) : 0.0f;
+#pragma unroll
+        for (int j = 0; j < 16; ++j) p[j] = __fmul_rn(p[j], inv_z);
+
+        float sum_topk = 0.0f;
+        for (int c = 0; c < CANDS; ++c) {
+            float bv = -1.0f;
+            int bi = 0x7fffffff;
+#pragma unroll
+            for (int j = 0; j < 16; ++j) {
+                const int e = lane + j * 32;
+                if (e < NE && (p[j] > bv || (p[j] == bv && e < bi))) {
+                    bv = p[j];
+                    bi = e;
+                }
+            }
+#pragma unroll
+            for (int off = 16; off > 0; off >>= 1) {
+                const float ov = __shfl_xor_sync(0xffffffffu, bv, off);
+                const int oi = __shfl_xor_sync(0xffffffffu, bi, off);
+                if (ov > bv || (ov == bv && oi < bi)) {
+                    bv = ov;
+                    bi = oi;
+                }
+            }
+#pragma unroll
+            for (int j = 0; j < 16; ++j) {
+                if (lane + j * 32 == bi) p[j] = -1.0f;
+            }
+            if (lane == 0) {
+                cand_id[r][c] = bi;
+                cand_p[r][c] = (bv > 0.0f) ? bv : 0.0f;
+                if (c < TOPK && bv > 0.0f) sum_topk = __fadd_rn(sum_topk, bv);
+                if (bi < NE && bv > 0.0f) {
+                    if (c < KEEP) atomicOr(&in_set[bi >> 5], 1u << (bi & 31));
+                    atomicAdd(&score[bi], (c < TOPK) ? bv : __fmul_rn(0.25f, bv));
+                }
+            }
+        }
+        if (lane == 0) row_sum_topk[r] = sum_topk;
+    }
+    __syncthreads();
+
+    // Phase 2: expand expert union `in_set` up to `BUDGET` by picking highest-scoring remaining experts.
+    int cnt = 0;
+#pragma unroll
+    for (int w = 0; w < MAX_E / 32; ++w) cnt += __popc(in_set[w]);
+    const int target_b = min(NE, max(cnt, BUDGET));
+    while (cnt < target_b) {
+        float bv = -1.0f;
+        int bi = 0x7fffffff;
+#pragma unroll
+        for (int j = 0; j < 2; ++j) {
+            const int e = t + j * 256;
+            if (e < NE && ((in_set[e >> 5] >> (e & 31)) & 1u) == 0u) {
+                const float sv = score[e];
+                if (sv > bv || (sv == bv && e < bi)) {
+                    bv = sv;
+                    bi = e;
+                }
+            }
+        }
+#pragma unroll
+        for (int off = 16; off > 0; off >>= 1) {
+            const float ov = __shfl_xor_sync(0xffffffffu, bv, off);
+            const int oi = __shfl_xor_sync(0xffffffffu, bi, off);
+            if (ov > bv || (ov == bv && oi < bi)) {
+                bv = ov;
+                bi = oi;
+            }
+        }
+        if (lane == 0) {
+            red_v[warp] = bv;
+            red_i[warp] = bi;
+        }
+        __syncthreads();
+        float best_v = red_v[0];
+        int best_i = red_i[0];
+#pragma unroll
+        for (int w = 1; w < 8; ++w) {
+            if (red_v[w] > best_v || (red_v[w] == best_v && red_i[w] < best_i)) {
+                best_v = red_v[w];
+                best_i = red_i[w];
+            }
+        }
+        if (best_v <= 0.0f || best_i >= NE) break;
+        if (t == 0) in_set[best_i >> 5] |= (1u << (best_i & 31));
+        __syncthreads();
+        cnt += 1;
+    }
+
+    // Phase 3: each row selects up to TOPK candidates from `in_set` in rank order, with Parseval renormalization.
+    const unsigned below = (1u << lane) - 1u;
+    for (int r = warp; r < M; r += 8) {
+        if (lane < TOPK) {
+            PICK[static_cast<long long>(r) * SLOTS + lane] = NE;
+            WTS[static_cast<long long>(r) * SLOTS + lane] = 0.0f;
+        }
+        const int id = cand_id[r][lane];
+        const float pv = cand_p[r][lane];
+        const bool ok = (id >= 0 && id < NE) && (((in_set[id >> 5] >> (id & 31)) & 1u) != 0u);
+        const unsigned mask = __ballot_sync(0xffffffffu, ok);
+        const int rank = __popc(mask & below);
+        const bool chosen = ok && (rank < TOPK);
+        float sum_kept = chosen ? pv : 0.0f;
+#pragma unroll
+        for (int off = 16; off > 0; off >>= 1) sum_kept = __fadd_rn(sum_kept, __shfl_xor_sync(0xffffffffu, sum_kept, off));
+        float denom = (PARSEVAL && row_sum_topk[r] > 0.0f) ? row_sum_topk[r] : sum_kept;
+        if (denom <= 0.0f) denom = 1.0f;
+        if (chosen) {
+            PICK[static_cast<long long>(r) * SLOTS + rank] = id;
+            WTS[static_cast<long long>(r) * SLOTS + rank] = rbf(__fdiv_rn(pv, denom));
+        }
+        if (shared && lane == 0) {
+            PICK[static_cast<long long>(r) * SLOTS + TOPK] = NE;
+            WTS[static_cast<long long>(r) * SLOTS + TOPK] = rbf(tf_sigmoid(rbf(L[static_cast<long long>(r) * NL + NE])));
+        }
+    }
+}
