+
+    /// Verify-time expert-union budgeted top-k across `rows` (2 <= rows <= 64, experts <= 512) with optional Parseval renorm.
+    pub fn topkBudget(g: *const RouteRows, s: Stream, l: u64, ld: usize, experts: usize, top_k: usize, picks: u64, wts: u64, slots: usize, rows: usize, shared: bool, keep: usize, budget: usize, parseval: bool) !void {
+        const need = experts + @intFromBool(shared);
+        if (experts > 512 or rows == 0 or rows > 64 or top_k == 0 or top_k > 16 or top_k > experts or slots < top_k + @intFromBool(shared) or ld < need) return error.RowShape;
+        var a: launch_.Args = .{};
+        a.add(l);
+        for ([_]usize{ ld, experts, top_k }) |v| a.add(@as(i32, @intCast(v)));
+        a.add(picks);
+        a.add(wts);
+        a.add(@as(i32, @intCast(slots)));
+        a.add(@as(i32, @intFromBool(shared)));
+        for ([_]usize{ rows, keep, budget }) |v| a.add(@as(i32, @intCast(v)));
+        a.add(@as(i32, @intFromBool(parseval)));
+        try launch_.launch(g.topk_budget_fn, .{ .grid = .{ .x = 1, .y = 1, .z = 1 }, .block = .{ .x = 256 } }, s, &a);
+    }
 };
 
