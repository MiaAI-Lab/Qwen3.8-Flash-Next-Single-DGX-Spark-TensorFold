+/// A safetensors file of `list` at `path` in `dir` (the tests' stand-in for an identity's file).
+fn writeFile(a: std.mem.Allocator, io: std.Io, dir: std.Io.Dir, path: []const u8, list: []const Named) !void {
+    var header: std.Io.Writer.Allocating = .init(a);
+    defer header.deinit();
+    try header.writer.writeAll("{");
+    var at: usize = 0;
+    for (list, 0..) |s, i| {
+        try header.writer.print("{s}\"{s}\":{{\"dtype\":\"{s}\",\"shape\":[", .{ if (i == 0) "" else ",", s.name, s.dtype });
+        for (s.shape, 0..) |d, j| try header.writer.print("{s}{d}", .{ if (j == 0) "" else ",", d });
+        try header.writer.print("],\"data_offsets\":[{d},{d}]}}", .{ at, at + s.bytes.len });
+        at += s.bytes.len;
+    }
+    try header.writer.writeAll("}");
+    const head = header.written();
+    const image = try a.alloc(u8, 8 + head.len + at);
+    defer a.free(image);
+    std.mem.writeInt(u64, image[0..8], head.len, .little);
+    @memcpy(image[8..][0..head.len], head);
+    var p: usize = 8 + head.len;
+    for (list) |s| {
+        @memcpy(image[p..][0..s.bytes.len], s.bytes);
+        p += s.bytes.len;
+    }
+    try dir.writeFile(io, .{ .sub_path = path, .data = image });
+}
