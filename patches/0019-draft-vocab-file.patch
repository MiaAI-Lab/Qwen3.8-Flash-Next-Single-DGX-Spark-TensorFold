+/// Load an optional CUDA draft vocabulary once; the same IDs drive head rows and sampling.
+fn runtimeDraftIds(gpa: std.mem.Allocator, io: std.Io) ![]u32 {
+    const raw = std.c.getenv("TENSORFOLD_DRAFT_VOCAB") orelse return draftIds(gpa);
+    const path = std.mem.trim(u8, std.mem.span(raw), " \t");
+    if (path.len == 0 or std.mem.eql(u8, path, "default")) return draftIds(gpa);
+    const text = std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 26)) catch |err| {
+        std.log.err("TENSORFOLD_DRAFT_VOCAB={s}: {s}", .{ path, @errorName(err) });
+        return err;
+    };
+    defer gpa.free(text);
+    const ids = try proposal.legacy.ids(gpa, text, .{ .vocab = vocab, .delimiters = " \t\r\n," });
+    std.log.info("draft vocabulary: {d} ids from TENSORFOLD_DRAFT_VOCAB", .{ids.len});
+    return ids;
+}
