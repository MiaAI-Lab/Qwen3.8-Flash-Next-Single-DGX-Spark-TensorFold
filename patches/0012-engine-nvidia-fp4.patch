+/// MXFP8 rows to bf16: e4m3 code x 2^(e8m0 - 127) in fp32 (0 is 2^-127, 255 NaN), bf16 RNE; one scale per 32 inputs.
+pub fn mx8Widen(codes: []const u8, scales: []const u8, n: usize, k: usize, out: []u8) void {
+    var lut: [256]f32 = undefined;
+    for (&lut, 0..) |*v, i| v.* = lay.e4m3ToF32(@intCast(i));
+    const kg = k / 32;
+    for (0..n) |r| for (0..kg) |g| {
+        const e = scales[r * kg + g];
+        const f: f32 = if (e == 255) std.math.nan(f32) else if (e == 0) lay.bitsF32(0x00400000) else lay.bitsF32(@as(u32, e) << 23);
+        for (0..32) |j| {
+            const i = r * k + g * 32 + j;
+            std.mem.writeInt(u16, out[2 * i ..][0..2], lay.bf16Rne(lut[codes[i]] * f), .little);
+        }
+    };
+}
