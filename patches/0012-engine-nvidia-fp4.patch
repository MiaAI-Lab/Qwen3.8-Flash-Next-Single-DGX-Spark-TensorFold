+    try std.testing.expectEqual(@as(u16, 0x4460), std.mem.readInt(u16, out[4..6], .little));
+    mx8Widen(&codes, &.{120}, 1, 32, &out);
+    try std.testing.expectEqual(@as(u16, 0x3C00), std.mem.readInt(u16, out[0..2], .little)); // 2^-7
+}
