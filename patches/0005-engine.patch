+    g.advance(&h, &.{3});
+    try std.testing.expectEqualSlices(i64, &.{ 2, 3 }, &h);
+    g.advance(&h, &.{ 4, 5, 6 });
+    try std.testing.expectEqualSlices(i64, &.{ 5, 6 }, &h);
+    g.advance(&h, &.{});
