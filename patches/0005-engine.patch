+    try std.testing.expectEqual(@as(usize, 13952), d.attnWidth());
+    try std.testing.expectEqual(@as(usize, 16480), d.projWidth());
+}
+
+test {
+    std.testing.refAllDecls(@This());
+    std.testing.refAllDecls(Engine);
+}
